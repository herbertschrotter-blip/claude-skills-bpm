{
  "name": "workbench",
  "owner": {
    "name": "Herbert Schrotter"
  },
  "description": "Herberts Werkbank für Claude Code: Skills für die Projektarbeit und für die Skill-Arbeit, dazu Skill-Log und Skill-Wächter.",
  "plugins": [
    {
      "name": "work",
      "source": "./",
      "strict": false,
      "description": "Skills für die Projektarbeit (Code, Mockups, Doku, Tickets, Tracker, Commits, Übergaben, Sitzungen, Reviews), dazu Skill-Log und Skill-Wächter als Hooks.",
      "skills": [
        "./skills/code-erstellen",
        "./skills/mockup-erstellen",
        "./skills/doc-pflege",
        "./skills/ticket",
        "./skills/projekt-anlegen",
        "./skills/tracker",
        "./skills/git-commit-helper",
        "./skills/audit",
        "./skills/chat-wechsel",
        "./skills/sitzung",
        "./skills/chatgpt-review"
      ],
      "commands": [
        "./tools/commands/statistik.md"
      ],
      "userConfig": {
        "log_host": {
          "type": "string",
          "title": "Rechnername im Skill-Log",
          "description": "Name dieses Rechners im Skill-Log (z. B. laptop). Leer = Hostname.",
          "default": ""
        },
        "skill_log": {
          "type": "boolean",
          "title": "Skill-Log",
          "description": "Prompts und Skill-Zündungen lokal protokollieren (~/.claude/skill-log).",
          "default": true
        },
        "skill_guard": {
          "type": "boolean",
          "title": "Skill-Wächter",
          "description": "Änderungen an Code, Doku und Mockups nur mit dem zuständigen Skill; Commits und ClickUp ohne Skill melden.",
          "default": true
        },
        "guard_rules": {
          "type": "string",
          "title": "Eigene Wächter-Regeln",
          "description": "Pfad zu einer eigenen Regeldatei statt der mitgelieferten regeln.json. Leer = mitgeliefert.",
          "default": ""
        },
        "log_dir": {
          "type": "string",
          "title": "Ordner des Skill-Logs",
          "description": "Ablage des Skill-Logs. Leer = ~/.claude/skill-log.",
          "default": ""
        },
        "log_repo": {
          "type": "string",
          "title": "Sammel-Repo für das Skill-Log",
          "description": "Privates GitHub-Repo owner/name, in das jeder Rechner sein Skill-Log beim Sitzungsstart abgleicht (enthält Prompt-Texte – nur privat!). Leer = kein Abgleich.",
          "default": ""
        }
      },
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_log.py\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_sync.py\"",
                "timeout": 10
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_log.py\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_guard.py\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Skill",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_log.py\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__.*[Cc]lick[Uu]p.*",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_guard.py\"",
                "timeout": 10
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/work-hooks/hooks/skill_log.py\"",
                "timeout": 10
              }
            ]
          }
        ]
      }
    },
    {
      "name": "skill-workshop",
      "source": "./",
      "strict": false,
      "description": "Skills für die Arbeit an Skills: neu anlegen, pflegen, aus dem Skill-Log auswerten.",
      "skills": [
        "./skills/skill-neu",
        "./skills/skill-pflege",
        "./skills/skill-auswertung"
      ]
    },
    {
      "name": "work-hooks",
      "source": "./plugins/work-hooks",
      "description": "Nur Skill-Log und Skill-Wächter, ohne Skills – für Rechner, auf denen die Skills aus claude.ai kommen (z. B. Claude-Desktop-App). Nie zusammen mit work installieren."
    }
  ]
}
